        <mxCell id="thread-keyboard" value="&lt;b&gt;Keyboard Listener&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;pynput.keyboard.Listener&lt;br&gt;Global hotkey detection&lt;br&gt;Calls toggle_recording()&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;shadow=1" parent="1" vertex="1">
          <mxGeometry x="410" y="730" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="thread-recording" value="&lt;b&gt;Recording Thread&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;daemon=True (spawned)&lt;br&gt;recording_loop()&lt;br&gt;Audio + transcription&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;shadow=1" parent="1" vertex="1">
          <mxGeometry x="580" y="730" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="thread-sync" value="&lt;b&gt;Synchronization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;recording_event: Start/stop signal&lt;br&gt;state_lock: Protect toggle&lt;br&gt;whisper_model_lock: Lazy load&lt;br&gt;&lt;b&gt;No deadlocks (lock hierarchy)&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;shadow=1" parent="1" vertex="1">
          <mxGeometry x="750" y="730" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;shadow=1;dashed=1" parent="1" vertex="1">
          <mxGeometry x="1050" y="680" width="600" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle-title" value="&lt;b&gt;LIFECYCLE &amp; SHUTDOWN&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14" parent="1" vertex="1">
          <mxGeometry x="1050" y="690" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle-startup" value="&lt;b&gt;Startup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;1. Load icons&lt;br&gt;2. Spawn tray thread&lt;br&gt;3. Start keyboard listener&lt;br&gt;4. Main loop (keep alive)&lt;br&gt;⏱️ 200ms to ready&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;shadow=1" parent="1" vertex="1">
          <mxGeometry x="1070" y="730" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle-recording" value="&lt;b&gt;Recording Lifecycle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;Start: recording_event.set()&lt;br&gt;Loop: while is_set()&lt;br&gt;Stop: recording_event.clear()&lt;br&gt;Exit: Thread terminates (&lt;1s)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;shadow=1" parent="1" vertex="1">
          <mxGeometry x="1220" y="730" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle-shutdown" value="&lt;b&gt;Shutdown (quit_program)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;1. recording_event.clear()&lt;br&gt;2. recording_thread.join(1s)&lt;br&gt;3. icon.stop()&lt;br&gt;4. os._exit(0) → Fast exit&lt;br&gt;⏱️ &lt;1 second total&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;shadow=1" parent="1" vertex="1">
          <mxGeometry x="1380" y="730" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle-windows" value="&lt;b&gt;Windows Shutdown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;OS terminates process&lt;br&gt;Memory released (Whisper)&lt;br&gt;Disk cache preserved&lt;br&gt;Auto-start: Works on reboot&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;shadow=1" parent="1" vertex="1">
          <mxGeometry x="1540" y="730" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;shadow=1" parent="1" vertex="1">
          <mxGeometry x="310" y="970" width="1120" height="270" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="&lt;b&gt;LEGEND&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="350" y="985" width="370" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-text" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;v2.0 introduces hybrid speech-to-text:&lt;/b&gt; Offline (Whisper) + Online (Google) with user-selectable engines via system tray menu.&lt;br&gt;&lt;br&gt;&lt;b&gt;Key Components:&lt;/b&gt;&lt;br&gt;• System Tray: pystray daemon thread (icon, menu, notifications)&lt;br&gt;• Audio Capture: Recording thread (SpeechRecognition + PyAudio)&lt;br&gt;• Whisper Engine: faster-whisper with INT8 quantization (1-2s latency, 75MB model, offline)&lt;br&gt;• Google Engine: Web Speech API (0.5s latency, cloud-powered, excellent accuracy)&lt;br&gt;• CLI Detection: Win32 API window validation (cmd.exe, powershell.exe, WindowsTerminal.exe only)&lt;br&gt;&lt;br&gt;&lt;b&gt;Threading:&lt;/b&gt; 3 concurrent threads (main, tray, recording) with synchronization via threading.Event + threading.Lock&lt;br&gt;&lt;b&gt;Performance:&lt;/b&gt; Whisper ~1-2s (fair accuracy), Google ~0.5s (excellent accuracy), Auto-fallback on errors&lt;br&gt;&lt;b&gt;Storage:&lt;/b&gt; Model cache in %APPDATA%\stt-cli\models (75MB), Settings in %APPDATA%\stt-cli\settings.json&lt;br&gt;&lt;b&gt;Security:&lt;/b&gt; CLI-only output (prevents typing into browsers/editors), Whisper 100% local (privacy-focused)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="330" y="1010" width="550" height="110" as="geometry" />
        </mxCell>
        <mxCell id="perf-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;shadow=1;dashPattern=1 4;" parent="1" vertex="1">
          <mxGeometry x="1068" y="1003" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="perf-title" value="&lt;b&gt;PERFORMANCE METRICS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=13" parent="1" vertex="1">
          <mxGeometry x="993" y="1013" width="450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="perf-table" value="&lt;table border=&quot;1&quot; style=&quot;font-size:8px;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th&gt;Metric&lt;/th&gt;&lt;th&gt;Whisper&lt;/th&gt;&lt;th&gt;Google&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Latency&lt;/td&gt;&lt;td&gt;1-2s&lt;/td&gt;&lt;td&gt;0.5s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Accuracy&lt;/td&gt;&lt;td&gt;Fair&lt;/td&gt;&lt;td&gt;Excellent&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RAM (idle)&lt;/td&gt;&lt;td&gt;~80MB&lt;/td&gt;&lt;td&gt;~80MB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RAM (recording)&lt;/td&gt;&lt;td&gt;~1.5GB&lt;/td&gt;&lt;td&gt;~100MB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;First Load&lt;/td&gt;&lt;td&gt;5-10s&lt;/td&gt;&lt;td&gt;Instant&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Model Size&lt;/td&gt;&lt;td&gt;75MB&lt;/td&gt;&lt;td&gt;N/A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;❌ Not required&lt;/td&gt;&lt;td&gt;✅ Required&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Privacy&lt;/td&gt;&lt;td&gt;100% Local&lt;/td&gt;&lt;td&gt;Cloud API&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1133" y="1053" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="CC7R70edGU6rccT_nzHu-3" value="&lt;font style=&quot;&quot;&gt;&lt;b&gt;Examples&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; text-align: start; text-wrap-mode: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bb%26gt%3BKeyboard%20Controller%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%208px%3B%26quot%3B%26gt%3Bpynput.keyboard.Controller%26lt%3Bbr%26gt%3BType%3A%20transcription%20%2B%20space%26lt%3Bbr%26gt%3BOnly%20if%20CLI%20active%26lt%3B%2Ffont%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3BfillColor%3D%23f0f0f0%3BstrokeColor%3D%23666666%3BfontSize%3D10%3Bshadow%3D1%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%22750%22%20y%3D%22490%22%20width%3D%22150%22%20height%3D%2270%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;ClaudeCode, Geminai CLI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;shadow=0;gradientColor=none;dashed=1;dashPattern=1 2;" parent="1" vertex="1">
